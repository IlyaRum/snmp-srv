NTC-SNMP-MIB DEFINITIONS ::= BEGIN

IMPORTS
    MODULE-IDENTITY, OBJECT-TYPE, NOTIFICATION-TYPE,
    Integer32, Gauge32, TimeTicks, IpAddress, Counter32,
    enterprises, snmpModules
        FROM SNMPv2-SMI
    TEXTUAL-CONVENTION, DisplayString, DateAndTime,
    TruthValue, RowStatus, TimeStamp
        FROM SNMPv2-TC
    MODULE-COMPLIANCE, OBJECT-GROUP, NOTIFICATION-GROUP
        FROM SNMPv2-CONF;

-- Идентификация модуля

ntc MODULE-IDENTITY
    LAST-UPDATED "202605221625Z"
    ORGANIZATION "NTC"
    CONTACT-INFO "IlyaR"
    DESCRIPTION
        "MIB для мониторинга API сервиса и отправки трапов."
    REVISION "202605221625Z"
    DESCRIPTION "Initial version."
    ::= { enterprises 63573 }

-- Основные ветки

ntcSystem        OBJECT IDENTIFIER ::= { ntc 0 7 7 }
ntcTrapEvents    OBJECT IDENTIFIER ::= { ntc 0 7 7 }

-- Ветка для конфигурации и состояния (0.7 из config.json)
ntcSnmp          OBJECT IDENTIFIER ::= { ntc 0 7 7 }

ntcSystemState   OBJECT IDENTIFIER ::= { ntcSnmp 1 }
ntcAlertObjects  OBJECT IDENTIFIER ::= { ntcSnmp 2 }
ntcStateTable    OBJECT IDENTIFIER ::= { ntcSnmp 3 }
ntcSeverityLevel OBJECT IDENTIFIER ::= { ntcSnmp 4 }

-- Базовые скалярные объекты состояния

ntcSystemAvailable OBJECT-TYPE
    SYNTAX      DisplayString (SIZE (0..255))
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Текущая дата и время системы."
    ::= { ntcSystemState 1 }

ntcApiAccess OBJECT-TYPE
    SYNTAX      INTEGER { on(1), off(0) }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Статус доступа к API сервису. 1 - доступен, 0 - недоступен."
    ::= { ntcSystemState 2 }

-- Таблица состояний (для расширяемости)

ntcStateTableEntry OBJECT-TYPE
    SYNTAX      NtcStateTableEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "Запись в таблице состояний."
    INDEX       { ntcStateIndex }
    ::= { ntcStateTable 1 }

NtcStateTableEntry ::= SEQUENCE {
    ntcStateIndex          Integer32,
    ntcStateTargetName     DisplayString,
    ntcStateTargetType     DisplayString,
    ntcStateObjectState    DisplayString,
    ntcStateMetricValue    DisplayString
}

ntcStateIndex OBJECT-TYPE
    SYNTAX      Integer32 (1..255)
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "Индекс записи в таблице."
    ::= { ntcStateTableEntry 1 }

ntcStateTargetName OBJECT-TYPE
    SYNTAX      DisplayString (SIZE (0..255))
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Имя целевого сервиса (например, 'API service')."
    ::= { ntcStateTableEntry 2 }

ntcStateTargetType OBJECT-TYPE
    SYNTAX      DisplayString (SIZE (0..255))
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Тип целевого сервиса (например, 'API')."
    ::= { ntcStateTableEntry 3 }

ntcStateObjectState OBJECT-TYPE
    SYNTAX      DisplayString (SIZE (0..255))
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Состояние объекта (OK, CRITICAL_ERROR, UNKNOWN)."
    ::= { ntcStateTableEntry 4 }

ntcStateMetricValue OBJECT-TYPE
    SYNTAX      DisplayString (SIZE (0..255))
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Дополнительное метрическое значение."
    ::= { ntcStateTableEntry 5 }

-- Объекты для трапа (alert)

alertTargetName OBJECT-TYPE
    SYNTAX      DisplayString (SIZE (0..255))
    MAX-ACCESS  accessible-for-notify
    STATUS      current
    DESCRIPTION
        "Имя целевого сервиса, вызвавшего событие."
    ::= { ntcAlertObjects 1 }

alertTargetType OBJECT-TYPE
    SYNTAX      DisplayString (SIZE (0..255))
    MAX-ACCESS  accessible-for-notify
    STATUS      current
    DESCRIPTION
        "Тип целевого сервиса."
    ::= { ntcAlertObjects 2 }

alertHostName OBJECT-TYPE
    SYNTAX      DisplayString (SIZE (0..255))
    MAX-ACCESS  accessible-for-notify
    STATUS      current
    DESCRIPTION
        "Имя хоста, на котором произошло событие."
    ::= { ntcAlertObjects 3 }

alertMetricName OBJECT-TYPE
    SYNTAX      DisplayString (SIZE (0..255))
    MAX-ACCESS  accessible-for-notify
    STATUS      current
    DESCRIPTION
        "Имя метрики (например, 'API control')."
    ::= { ntcAlertObjects 4 }

alertKeyName OBJECT-TYPE
    SYNTAX      DisplayString (SIZE (0..255))
    MAX-ACCESS  accessible-for-notify
    STATUS      current
    DESCRIPTION
        "Ключ метрики (например, 'API work')."
    ::= { ntcAlertObjects 5 }

alertKeyValue OBJECT-TYPE
    SYNTAX      DisplayString (SIZE (0..255))
    MAX-ACCESS  accessible-for-notify
    STATUS      current
    DESCRIPTION
        "Значение ключа (например, описание события)."
    ::= { ntcAlertObjects 6 }

alertTimeStamp OBJECT-TYPE
    SYNTAX      DisplayString (SIZE (0..255))
    MAX-ACCESS  accessible-for-notify
    STATUS      current
    DESCRIPTION
        "Временная метка события."
    ::= { ntcAlertObjects 7 }

alertSeverity OBJECT-TYPE
    SYNTAX      DisplayString (SIZE (0..255))
    MAX-ACCESS  accessible-for-notify
    STATUS      current
    DESCRIPTION
        "Уровень серьезности (CLEARED, CRITICAL)."
    ::= { ntcAlertObjects 8 }

alertMessage OBJECT-TYPE
    SYNTAX      DisplayString (SIZE (0..255))
    MAX-ACCESS  accessible-for-notify
    STATUS      current
    DESCRIPTION
        "Сообщение события."
    ::= { ntcAlertObjects 9 }

alertRuleName OBJECT-TYPE
    SYNTAX      DisplayString (SIZE (0..255))
    MAX-ACCESS  accessible-for-notify
    STATUS      current
    DESCRIPTION
        "Имя правила доступа."
    ::= { ntcAlertObjects 10 }

alertRuleOwner OBJECT-TYPE
    SYNTAX      DisplayString (SIZE (0..255))
    MAX-ACCESS  accessible-for-notify
    STATUS      current
    DESCRIPTION
        "Владелец правила."
    ::= { ntcAlertObjects 11 }

alertMetricValue OBJECT-TYPE
    SYNTAX      DisplayString (SIZE (0..255))
    MAX-ACCESS  accessible-for-notify
    STATUS      current
    DESCRIPTION
        "Значение метрики (может быть пустым)."
    ::= { ntcAlertObjects 12 }

alertContext OBJECT-TYPE
    SYNTAX      DisplayString (SIZE (0..255))
    MAX-ACCESS  accessible-for-notify
    STATUS      current
    DESCRIPTION
        "Контекст события (может быть пустым)."
    ::= { ntcAlertObjects 13 }

-- ОПРЕДЕЛЕНИЕ TRAP

ntcApiServiceTrap NOTIFICATION-TYPE
    OBJECTS {
        alertTargetName,
        alertTargetType,
        alertHostName,
        alertMetricName,
        alertKeyName,
        alertKeyValue,
        alertTimeStamp,
        alertSeverity,
        alertMessage,
        alertRuleName,
        alertRuleOwner,
        alertMetricValue,
        alertContext
    }
    STATUS current
    DESCRIPTION
        "Trap-сообщение о состоянии API сервиса.
         Отправляется при изменении доступности API:
         - при восстановлении связи (alertSeverity = CLEARED)
         - при потере связи (alertSeverity = CRITICAL)
         Содержит полную информацию об источнике, времени, правиле и владельце."
    ::= { ntcTrapEvents 2 }

-- Соответствие OIDs:
-- alertTargetName        = 1.3.6.1.4.1.63573.0.7.2.1
-- alertTargetType        = 1.3.6.1.4.1.63573.0.7.2.2
-- alertHostName          = 1.3.6.1.4.1.63573.0.7.2.3
-- alertMetricName        = 1.3.6.1.4.1.63573.0.7.2.4
-- alertKeyName           = 1.3.6.1.4.1.63573.0.7.2.5
-- alertKeyValue          = 1.3.6.1.4.1.63573.0.7.2.6
-- alertTimeStamp         = 1.3.6.1.4.1.63573.0.7.2.7
-- alertSeverity          = 1.3.6.1.4.1.63573.0.7.2.8
-- alertMessage           = 1.3.6.1.4.1.63573.0.7.2.9
-- alertRuleName          = 1.3.6.1.4.1.63573.0.7.2.10
-- alertRuleOwner         = 1.3.6.1.4.1.63573.0.7.2.11
-- alertMetricValue       = 1.3.6.1.4.1.63573.0.7.2.12
-- alertContext           = 1.3.6.1.4.1.63573.0.7.2.13

END
